# Base URL of the Dove API (server-only; never exposed to the browser).
# Local stub: bun dev:stub  →  http://localhost:4010/api/v1
DOVE_API_URL="http://localhost:4010/api/v1"

# Public origin of this app (used in metadata and install instructions).
APP_URL="http://localhost:3100"

# Public VAPID key for Web Push. Safe to expose, and it must never change between
# environments: every existing subscription is tied to it. Matches Dove's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BB1x7lLZO33ze87XXCSws0TRhmhajAmv_HHV76Y3GkIsgpx45MDfJPnwIOWDQZdYROXfsDqLdhUA_aegi0f1tW4"

# The church's WhatsApp number (optional, server-only). When set, the sign-in screen offers
# "Message us on WhatsApp" to people who have a phone but no email, so staff can send them a link.
CHURCH_WHATSAPP_NUMBER=""
