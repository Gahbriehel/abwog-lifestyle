{
  "name": "abwog-lifestyle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:stub": "bun scripts/dove-stub.ts",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "check-types": "tsc --pretty --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "bun scripts/generate-icons.ts",
    "check-all": "bun run check-types && bun run lint && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "lucide-react": "^1.66.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
